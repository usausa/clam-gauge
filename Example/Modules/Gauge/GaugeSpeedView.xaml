<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Gauge"
             xmlns:clam="clr-namespace:ClamGauge;assembly=ClamGauge" xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             x:Class="Example.Modules.Gauge.GaugeSpeedView"
             x:DataType="{x:Type module:GaugeSpeedViewModel}"
             s:BindingContextResolver.Type="{x:Type module:GaugeSpeedViewModel}"
             shell:ShellProperty.Title="Speed"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Setting"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <ContentView.Resources>
        <Style x:Key="SpeedGauge"
               TargetType="clam:ClamGaugeView"
               BasedOn="{StaticResource GaugeView}">
            <Setter Property="MinValue" Value="0" />
            <Setter Property="MaxValue" Value="200" />
            <Setter Property="ValueColor" Value="#1A2E48" />
            <Setter Property="GaugeBackgroundStartColor" Value="#5070A0" />
            <Setter Property="GaugeBackgroundEndColor" Value="#E4F2FC" />
            <Setter Property="BezelOuterThickness" Value="3.5" />
            <Setter Property="BezelOuterStartColor" Value="#D8EEFF" />
            <Setter Property="BezelOuterEndColor" Value="#7888A8" />
            <Setter Property="BezelInnerThickness" Value="2" />
            <Setter Property="BezelInnerStartColor" Value="#5A6878" />
            <Setter Property="BezelInnerEndColor" Value="#B8D4F0" />
            <Setter Property="ArcInnerExtent" Value="0.82" />
            <Setter Property="ArcOuterExtent" Value="0.94" />
            <Setter Property="ArcTrackColor" Value="#25000000" />
            <Setter Property="MajorTickInterval" Value="20" />
            <Setter Property="MajorTickInnerExtent" Value="0.76" />
            <Setter Property="MajorTickOuterExtent" Value="0.94" />
            <Setter Property="MajorTickColor" Value="White" />
            <Setter Property="MinorTickInterval" Value="10" />
            <Setter Property="MinorTickInnerExtent" Value="0.82" />
            <Setter Property="MinorTickOuterExtent" Value="0.94" />
            <Setter Property="MinorTickColor" Value="#B0C8E0" />
            <Setter Property="LabelInterval" Value="40" />
            <Setter Property="LabelExtent" Value="0.64" />
            <Setter Property="LabelFormat" Value="{}{0:N0}" />
            <Setter Property="LabelFontSize" Value="18" />
            <Setter Property="LabelColor" Value="#1A2E48" />
            <Setter Property="ValueFormat" Value="{}{0:N0}" />
            <Setter Property="ValueFontSize" Value="48" />
            <Setter Property="ValueOffsetY" Value="0.5" />
            <Setter Property="Unit" Value="km/h" />
            <Setter Property="UnitFontSize" Value="14" />
            <Setter Property="UnitColor" Value="#204060" />
            <Setter Property="NeedleEndExtent" Value="0.90" />
            <Setter Property="NeedleStartWidth" Value="8" />
            <Setter Property="NeedleLeftColor" Value="#CC1818" />
            <Setter Property="NeedleRightColor" Value="#DD2828" />
            <Setter Property="PivotRadius" Value="6" />
            <Setter Property="PivotColor" Value="#CC1818" />
            <Setter Property="Ranges">
                <Setter.Value>
                    <x:Array Type="{x:Type clam:GaugeRange}">
                        <clam:GaugeRange EndColor="#C8D020" EndValue="80" StartColor="#30CC30" StartValue="0" />
                        <clam:GaugeRange EndColor="#FF8020" EndValue="140" StartColor="#C8D020" StartValue="80" />
                        <clam:GaugeRange EndColor="#FF2020" EndValue="200" StartColor="#FF8020" StartValue="140" />
                    </x:Array>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentView.Resources>

    <Grid>
        <Grid Style="{StaticResource FillGrid}"
              RowDefinitions="*,Auto">
            <clam:ClamGaugeView Grid.Row="0"
                                Style="{StaticResource SpeedGauge}"
                                Value="{Binding Value}"
                                AnimationDuration="{Binding AnimationDuration}"
                                AnimationEasing="{Binding AnimationEasing}"
                                UnitPosition="{Binding UnitPosition}">
                <clam:ClamGaugeView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RandomCommand}" />
                </clam:ClamGaugeView.GestureRecognizers>
            </clam:ClamGaugeView>

            <Slider Grid.Row="1"
                    Style="{StaticResource GaugeSlider}"
                    Value="{Binding Value, Mode=TwoWay}"
                    Minimum="0" Maximum="200" />
        </Grid>

        <cmc:BottomSheetView Style="{StaticResource SettingSheet}"
                             IsOpen="{Binding IsSettingOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="{x:Type module:GaugeSpeedViewModel}">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitle}"
                               Text="動き" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*,*,*,*">
                            <Button Grid.Column="0"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectEasingCommand}"
                                    CommandParameter="{x:Int32 0}"
                                    Text="Cubic">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Int32 0}"
                                                 Binding="{Binding EasingIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectEasingCommand}"
                                    CommandParameter="{x:Int32 1}"
                                    Text="Linear">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Int32 1}"
                                                 Binding="{Binding EasingIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectEasingCommand}"
                                    CommandParameter="{x:Int32 2}"
                                    Text="Sin">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Int32 2}"
                                                 Binding="{Binding EasingIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="3"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectEasingCommand}"
                                    CommandParameter="{x:Int32 3}"
                                    Text="Bounce">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Int32 3}"
                                                 Binding="{Binding EasingIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="4"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectEasingCommand}"
                                    CommandParameter="{x:Int32 4}"
                                    Text="Spring">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Int32 4}"
                                                 Binding="{Binding EasingIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <Label Style="{StaticResource SheetTitle}"
                               Text="時間" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*,*">
                            <Button Grid.Column="0"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectDurationCommand}"
                                    CommandParameter="{x:Int32 0}"
                                    Text="1000">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Int32 0}"
                                                 Binding="{Binding DurationIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectDurationCommand}"
                                    CommandParameter="{x:Int32 1}"
                                    Text="300">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Int32 1}"
                                                 Binding="{Binding DurationIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectDurationCommand}"
                                    CommandParameter="{x:Int32 2}"
                                    Text="0">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Int32 2}"
                                                 Binding="{Binding DurationIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <Label Style="{StaticResource SheetTitle}"
                               Text="表示" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*,*">
                            <Button Grid.Column="0"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding ToggleUnitCommand}"
                                    Text="{Binding UnitText}" />
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>
    </Grid>

</ContentView>
