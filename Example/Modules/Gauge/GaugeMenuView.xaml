<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Gauge"
             xmlns:modules="clr-namespace:Example.Modules"
             x:Class="Example.Modules.Gauge.GaugeMenuView"
             x:DataType="{x:Type module:GaugeMenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:GaugeMenuViewModel}"
             shell:ShellProperty.Title="ClamGauge"
             shell:ShellProperty.Function1Text="Exit"
             shell:ShellProperty.Function1Enabled="True">

    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*">
        <Button Grid.Row="0"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.GaugePressure}"
                Text="1.Pressure" />
        <Button Grid.Row="1"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.GaugeHumidity}"
                Text="2.Humidity" />
        <Button Grid.Row="2"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.GaugeTemperature}"
                Text="3.Temperature" />
        <Button Grid.Row="3"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.GaugeWind}"
                Text="4.Wind" />
        <Button Grid.Row="4"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.GaugeSpeed}"
                Text="5.Speed" />
        <Button Grid.Row="5"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.GaugeRpm}"
                Text="6.RPM" />
        <Button Grid.Row="6"
                Style="{StaticResource MenuButton}"
                IsEnabled="False"
                Text="" />
    </Grid>

</ContentView>
